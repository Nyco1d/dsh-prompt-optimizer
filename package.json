{
  "name": "dsh-prompt-optimizer-nyco1d",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "在输入框旁一键优化提示词：左键优化并左右对比，右键切换优化模式与模型。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyco1d/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/Nyco1d/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/Nyco1d/dsh-prompt-optimizer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-optimizer"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "modes.js",
    "templates/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
